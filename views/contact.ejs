        <div>
            <label for="email" class="block text-gray-900 font-medium text-base mb-2">
                Email address<span class="text-red-500">*</span>
            </label>
            <input type="email" id="email" name="email" required placeholder="Enter your email address"
                class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800 text-base" />
        </div>

        <div>
            <label for="phone" class="block text-gray-900 font-medium text-base mb-2">
                Phone number<span class="text-red-500">*</span>
            </label>
            <input type="tel" id="phone" name="phone" required placeholder="Enter your phone number"
                class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800 text-base" />
        </div>

        <div>
            <label for="message" class="block text-gray-900 font-medium text-base mb-2">
